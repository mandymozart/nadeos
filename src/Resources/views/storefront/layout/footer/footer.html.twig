{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{#
    Footer redesign (agents/PLAN.md "Footer redesign", mockup footer-entwurf-*.png).
    Column content stays Admin-driven (footer category tree + service menu); this only adds
    headline icons, a payment column and the layout split below. Every core block keeps parent().

    Legal pages (AGB, Widerrufsrecht, Datenschutz, Impressum) show only in the bottom row, not in
    the navigation columns. They are recognised by the CMS pages assigned under Admin >
    Grundeinstellungen, not by name - if none of those match a service-menu entry, nothing is
    filtered and both places render exactly as core does.
#}
{% block layout_footer_inner_container %}
    {% set nadeosLegalPageIds = [
        config('core.basicInformation.tosPage'),
        config('core.basicInformation.revocationPage'),
        config('core.basicInformation.privacyPage'),
        config('core.basicInformation.imprintPage'),
    ]|filter(id => id) %}
    {% set nadeosSplitLegalLinks = (footer.serviceMenu ?? [])|filter(item => item.cmsPageId in nadeosLegalPageIds)|length > 0 %}
    {{ parent() }}
{% endblock %}

{% block layout_footer_navigation_hotline_headline %}
    <div class="nadeos-footer-headline">
        {% sw_icon 'headset' %}
        {{ parent() }}
    </div>
{% endblock %}

{#
    Revocation link, rendered as its own row element after the columns (see
    layout_footer_navigation_columns): outside every collapse, so always visible on mobile, below
    the accordion; on desktop it wraps under the hotline column.
    Deliberate exception to "no hardcoded nav links" (agents/DESIGN.md, decided 2026-09-28): links
    the category "Widerrufen Sie Ihre Bestellung" (child of the inactive footer category
    "Widerufsformular", which only existed to give this link its own column) by ID. seoUrl()
    resolves the SEO URL of the current language. Shopware's own revocation button
    (Grundeinstellungen > "Widerrufs-Button anzeigen") must stay off, or the link shows twice.
#}
{% block layout_footer_navigation_columns %}
    {{ parent() }}

    <div class="col-12 order-md-last nadeos-footer-revocation">
        <a class="btn btn-buy"
           href="{{ seoUrl('frontend.navigation.page', { navigationId: '019edaa7d18f786eb6ce5a1fc0a2b721' }) }}"
           title="{{ 'nadeos.footer.revocationLink'|trans|striptags }}">
            {% sw_icon 'reply' style { size: 'sm' } %}
            {{ 'nadeos.footer.revocationLink'|trans|sw_sanitize }}
        </a>
    </div>

    <div class="col-md-4 footer-column nadeos-footer-payment-column">
        <div class="nadeos-footer-headline">
            {% sw_icon 'money-card' %}
            <div class="footer-column-headline footer-headline">
                {{ 'nadeos.footer.paymentHeadline'|trans|sw_sanitize }}
            </div>
        </div>
        {% set nadeosPaymentLogosInColumn = true %}
        {{ block('layout_footer_payment_logos') }}
    </div>
{% endblock %}

{# Icons for the Admin-driven columns, by position: 1st = Service, 2nd = Informationen. #}
{% block layout_footer_navigation_information_headline %}
    {% set nadeosColumnIcons = ['help', 'info'] %}
    <div class="nadeos-footer-headline">
        {% sw_icon nadeosColumnIcons[loop.index0]|default('info') %}
        {{ parent() }}
    </div>
{% endblock %}

{% block layout_footer_navigation_information_link_item %}
    {% if not (nadeosSplitLegalLinks and category.cmsPageId in nadeosLegalPageIds) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block layout_footer_service_menu_item %}
    {% if not nadeosSplitLegalLinks or serviceMenuItem.cmsPageId in nadeosLegalPageIds %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{#
    EU harmonised notice on the legal guarantee of conformity (Regulation (EU) 2025/1960).
    Shopware 6.7.14+ wires this natively into checkout (behind core.cart.showLegalGuaranteeNotice,
    a checkout-page-scoped toggle) and into the order confirmation mail, but never into a
    persistent site-wide placement. This adds the "general reminder on the website" placement
    the EU guidelines describe as its own, independent channel - it is NOT gated by the checkout
    toggle, since that setting only controls the checkout-page integration and a merchant has no
    legitimate reason to want the footer reminder hidden just because they haven't opted into
    the checkout variant. Reuses the same native sw_legal_guarantee_notice(_link) Twig filters
    and markup/classes the core checkout modal uses.
#}
{% block layout_footer_service_menu %}
    {{ parent() }}
    <div class="container nadeos-eu-notice-footer-row text-center">
        <button type="button"
                class="btn btn-link-inline"
                data-bs-toggle="modal"
                data-bs-target="#footerLegalGuaranteeNoticeModal"
                aria-haspopup="dialog">
            {{ 'checkout.confirmLegalGuaranteeNoticeLink'|trans|sw_sanitize }}
        </button>

        <div class="modal modal-lg fade"
             id="footerLegalGuaranteeNoticeModal"
             tabindex="-1"
             role="dialog"
             aria-modal="true"
             aria-hidden="true"
             aria-labelledby="footerLegalGuaranteeNoticeModal-header">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <div id="footerLegalGuaranteeNoticeModal-header" class="modal-title js-pseudo-modal-template-title-element h5">
                            {{ 'checkout.confirmLegalGuaranteeNoticeLink'|trans|sw_sanitize }}
                        </div>
                        <button class="btn-close close"
                                type="button"
                                data-bs-dismiss="modal"
                                aria-label="{{ 'global.default.close'|trans|striptags }}">
                        </button>
                    </div>
                    <div class="modal-body confirm-legal-guarantee-notice">
                        <a href="{{ context.languageId|sw_legal_guarantee_notice_link }}"
                           target="_blank"
                           rel="noopener">
                            {{ context.languageId|sw_legal_guarantee_notice }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{#
    Static payment icon row. The Stripe/Klarna plugins don't ship footer icons (Klarna only a
    single PNG badge), so this replaces the block entirely - no parent() - to avoid a duplicate
    Klarna logo. SVGs live in Resources/public/payment-icons (run `bin/console assets:install`).
    Edit the list to match the payment methods actually enabled.
    Rendered only in the payment column (see layout_footer_navigation_columns), not in the logo
    row below the columns.
#}
{% block layout_footer_payment_logos %}
    {% if nadeosPaymentLogosInColumn|default(false) %}
    {% set nadeosPaymentIcons = [
        { file: 'visa', name: 'Visa' },
        { file: 'mastercard', name: 'Mastercard' },
        { file: 'amex', name: 'American Express' },
        { file: 'eps', name: 'eps-Überweisung' },
        { file: 'klarna', name: 'Klarna' },
    ] %}
    <ul class="nadeos-payment-icons list-unstyled" aria-label="Zahlungsarten">
        {% for icon in nadeosPaymentIcons %}
            <li class="nadeos-payment-icon">
                <img src="{{ asset('bundles/nadeos/payment-icons/' ~ icon.file ~ '.svg', 'asset') }}"
                     alt="{{ icon.name }}"
                     title="{{ icon.name }}"
                     width="48"
                     height="32"
                     loading="lazy"
                     draggable="false">
            </li>
        {% endfor %}
    </ul>
    {% endif %}
{% endblock %}

{% block layout_footer_copyright %}
            {% endblock %}