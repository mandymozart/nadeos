{% sw_extends '@Framework/documents/style_base_portrait.css.twig' %}

{% block document_style %}
    {{ parent() }}

    @page {
        margin-top: 260px !important;
        margin-bottom: 100px !important;
    }

    footer {
        bottom: 50px !important;
    }

 .line-item-table {
    table-layout: fixed !important;
    width: 100% !important;
    border-spacing: 0 2px;
    border-collapse: collapse;
    padding-top: 20px;
}
.line-item-table th {
    padding-bottom: 12px !important;
}

    .line-item-table tbody tr:first-child > td {
        padding-top: 3px;
    }

    .line-item-table tbody tr > td {
        padding-bottom: 3px;
        padding-left: 0;
        padding-right: 0;
        word-break: break-word;
        overflow-wrap: break-word;
        border-bottom: 1px solid #ddd;
    }

    .line-item, .sum-container, .payment-shipping-container, .document-comment-container {
        line-height: 12px;
    }


    img.logo {
        position: relative !important;
        height: 90px !important;
        max-height: 90px !important;
        margin-left: 255px;
    }
    .letter-header {
        margin-top: 90px;
    }
    .recipient-address-container {
       padding-top: 20px;
       
    }
    .shipping-address-header {
        margin-top: 12px;
    }

    .payment-shipping-container, .delivery-info-additional {
        line-height: 1.1 !important;
        margin: 0 !important;
    }
{% endblock %}
